/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://dl.breizhzion.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

# Les polices ne changent jamais sans changer de nom de fichier : Cloudflare Pages les servait
# avec `max-age=14400`, soit quatre heures, donc un visiteur qui revient le lendemain les
# retelechargeait. Mesure faite le 2026-09-21 avant correction.
/polices/*
  Cache-Control: public, max-age=31536000, immutable

# ⛔ Un an et immuable, et c'est SEULEMENT acceptable parce que l'URL porte desormais une
# empreinte du contenu (`style.css?v=...`, posee par `scripts/poser-empreintes.py`). Sans elle,
# ce reglage figerait l'ancienne feuille chez les visiteurs pour un an.
#
# Le defaut de Cloudflare Pages etait `max-age=14400` : mesure le 2026-09-21, un navigateur passe
# dans les quatre heures precedentes servait encore la feuille d'AVANT la refonte, et rien ne le
# signalait puisque la page s'affichait simplement d'une autre epoque.
#
# ⚠️ Le navigateur met en cache l'URL COMPLETE, requete comprise : une empreinte differente est
# donc un objet different, et le fichier se recharge des que son contenu change.
/style.css
  Cache-Control: public, max-age=31536000, immutable

# Meme raison pour l'image de partage : son contenu est fige, et c'est la ressource la plus
# lourde du site.
/partage.png
  Cache-Control: public, max-age=2592000
